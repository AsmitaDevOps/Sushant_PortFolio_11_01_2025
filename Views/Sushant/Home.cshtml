}

h3 {
    font-size: 1.6em;
    font-weight: 600;
    margin-top: 10px;
}

.skills-section {
    display: flex;
    justify-content: space-around;
    margin-top: 30px;
}

.skill-box {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 20px;
    width: 30%;
    transition: transform 0.3s ease;
}

.skill-box:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
}

.skill-box h4 {
    font-size: 1.4em;
    margin-bottom: 10px;
    color: #ffcc00;
}

.skill-box p {
    font-size: 1em;
    line-height: 1.5;
}

.skill-img {
    width: 250px;
    height: 250px;
    margin-bottom: 10px;
}

/* Media Queries for responsiveness */
@@media screen and (max-width: 768px) {
    .skills-section {
        flex-direction: column;
        align-items: center;
    }

    .skill-box {
        width: 80%;
        margin-bottom: 20px;
    }
}



.journey-section {
    background: linear-gradient(to right, #00b4db, #0083b0); /* Gradient for modern look */
    padding: 50px 20px;
    color: white;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    width: 100%; /* Width adjustment for responsiveness */
    margin: auto; /* Centers the section horizontally */
}

.journey-section h2 {
    font-size: 2.5em;
    font-weight: 700;
    margin-bottom: 40px;
    color: #ffcc00;
}

.row {
    display: flex;
    justify-content: space-between;
    gap: 30px; /* Space between the two columns */
    flex-wrap: wrap; /* Allow wrapping in case of smaller screens */
}

.col-md-6 {
    flex: 1; /* Each column takes equal space */
    min-width: 45%; /* Prevent columns from becoming too small */
}

.education-box, .experience-box {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 10px;
    transition: transform 0.3s ease;
}

.education-box:hover, .experience-box:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
}

.section-icon {
    width: 150px;
    height: 150px;
    margin-bottom: 10px;
}

.education-box h3, .experience-box h3 {
    font-size: 1.8em;
    font-weight: 600;
    color: #ffcc00;
}

.experience-entry {
    margin-bottom: 20px;
}

.experience-entry h4 {
    font-size: 1.5em;
    font-weight: 600;
    color: #ffcc00;
}

.experience-entry ul {
    list-style-type: none;
    padding: 0;
    margin-top: 10px;
}

.experience-entry ul li {
    font-size: 1em;
    line-height: 1.6;
    color: #d3d3d3;
}

.experience-entry ul li::before {
    content: "•";
    color: #ffcc00;
    margin-right: 10px;
}

/* Media Queries for smaller screens */
@@media screen and (max-width: 768px) {
    .row {
        flex-direction: column;
        align-items: center;
    }

    .col-md-6 {
        min-width: 100%; /* Columns take full width on small screens */
        margin-bottom: 30px; /* Space between stacked sections */
    }

    .education-box, .experience-box {
        width: 100%; /* Ensure boxes take full width */
    }
}

   /* Projects Section Styling */
.projects-section {
    background: linear-gradient(135deg, #f06, #ffcc00); /* Add a gradient background */
    padding: 60px 20px;
    color: #fff;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
}

.projects-section h2 {
    font-size: 3em;
    font-weight: 700;
    color: #fff;
    margin-bottom: 40px;
    text-transform: uppercase;
}

.project-card {
    background: rgba(255, 255, 255, 0.85); /* Semi-transparent white background */
    margin: 20px auto;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    width: 90%;
/*    max-width: 900px;
*/    transition: all 0.3s ease-in-out;
    text-align: left;
    color: #333;
}

.project-card:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
}

.project-header h3 {
    font-size: 2.5em;
    font-weight: 600;
    color: #333;
    margin-bottom: 10px;
}

.project-description {
    font-size: 1.1em;
    color: #666;
    margin-bottom: 20px;
}

.technologies-used {
    margin-bottom: 20px;
}

.technologies-used h4 {
    font-size: 1.4em;
    font-weight: 600;
    color: #ffcc00;
    margin-bottom: 10px;
}

.technologies-used ul {
    list-style-type: none;
    padding-left: 0;
}

.technologies-used ul li {
    font-size: 1.1em;
    color: #555;
    margin-bottom: 5px;
}

.project-link {
    display: inline-block;
    padding: 12px 25px;
    background-color: #ffcc00;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 5px;
    transition: background-color 0.3s ease;
    margin-top: 20px;
}

.project-link:hover {
    background-color: #e0a800;
}

        @@media screen and (max-width: 768px) {
            .project-card {
                width: 100%;
            }

            .projects-section h2 {
                font-size: 2.2em;
            }
        }

       /* Section Background */
.contact-section {
    background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
    padding: 50px 0;
    text-align: center;
    border-radius: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Form Heading */
.contact-section h2 {
    font-size: 2.5em;
    margin-bottom: 20px;
    font-family: 'Arial', sans-serif;
    color: #333;
    text-transform: uppercase;
    letter-spacing: 2px;
}

/* Form styling */
.contact-form {
    display: inline-block;
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
/*    max-width: 500px;
*/    width: 100%;
}

/* Form fields container */
.form-field {
    position: relative;
    margin-bottom: 20px;
}

input, textarea {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 1em;
    outline: none;
    box-sizing: border-box;
}

input:focus, textarea:focus {
    border-color: #5e9ed6;
}

textarea {
    resize: vertical;
    height: 150px;
}

/* Icon styling inside input fields */
.form-field i {
    position: absolute;
    top: 50%;
    left: 10px;
    transform: translateY(-50%);
    font-size: 1.2em;
    color: #888;
}

/* Submit Button */
button {
    width: 100%;
    padding: 15px;
    border: none;
    background-color: #5e9ed6;
    color: white;
    font-size: 1.2em;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.3s ease, transform 0.3s ease;
}

button:hover {
    background-color: #4c8fb0;
    transform: scale(1.05);
}

/* Success Message Styling */
#success-message {
    margin-top: 20px;
    color: #28a745;
    font-size: 1.2em;
    font-weight: bold;
    display: none;
    animation: fadeIn 2s ease-in-out;
}

