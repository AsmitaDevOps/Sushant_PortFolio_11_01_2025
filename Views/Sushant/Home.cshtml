        /* About Me Section */
       .about-section {
    background: linear-gradient(to right, #6a11cb 0%, #2575fc 100%); /* gradient background */
    padding: 40px 20px;
    color: white;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
}

.about-section h2 {
    font-size: 2.5em;
    margin-bottom: 20px;
    font-weight: 700;
}

.profile-container {
    margin-bottom: 20px;
}

.profile-img {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    border: 5px solid #fff;
